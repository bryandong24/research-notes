---
import { getCollection } from "astro:content";

interface Props {
  currentId?: string;
}

const { currentId } = Astro.props;
const base = import.meta.env.BASE_URL;
const notes = (await getCollection("notes"))
  .filter((note) => !note.data.featured)
  .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
---

<ol class="research-series wide-block">
  {
    notes.map((note) => (
      <li class:list={{ "research-series__current": note.id === currentId }}>
        <span class="research-series__number">
          {String(note.data.seriesOrder).padStart(2, "0")}
        </span>
        <div>
          <p>
            {note.data.kind} · {note.data.readingMinutes} min
          </p>
          <a href={`${base}${note.id}/`}>{note.data.title}</a>
          <small>{note.data.summary}</small>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .research-series {
    max-width: 920px;
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--rule-dark);
  }

  .research-series li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .research-series__number {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .research-series p,
  .research-series small {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.68rem;
  }

  .research-series p {
    letter-spacing: 0.02em;
  }

  .research-series a {
    display: block;
    margin: 0.15rem 0 0.25rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
  }

  .research-series a:hover {
    color: var(--rust);
  }

  .research-series small {
    display: block;
    max-width: 760px;
    line-height: 1.5;
  }

  .research-series__current {
    background: linear-gradient(90deg, rgb(139 58 43 / 5%), transparent 65%);
  }
</style>
