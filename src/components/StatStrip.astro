---
interface Item {
  value: string;
  label: string;
  note: string;
  accent?: "rust" | "blue" | "gray" | "gold" | "teal";
}

interface Props {
  items: Item[];
  caption?: string;
}

const { items, caption } = Astro.props;
---

<figure class="stat-strip wide-block" aria-label={caption ?? "Headline results"}>
  <div class="stat-strip__grid">
    {
      items.map((item) => (
        <div class={`stat stat--${item.accent ?? "gray"}`}>
          <strong>{item.value}</strong>
          <span>{item.label}</span>
          <small>{item.note}</small>
        </div>
      ))
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .stat-strip {
    padding: 1.1rem 0 0.8rem;
    border-top: 1px solid var(--rule-dark);
    border-bottom: 1px solid var(--rule-dark);
  }

  .stat-strip__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    gap: 0;
  }

  .stat {
    min-width: 0;
    padding: 0.15rem clamp(1rem, 2.2vw, 1.6rem);
    border-left: 1px solid var(--rule);
  }

  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stat strong,
  .stat span,
  .stat small {
    display: block;
  }

  .stat strong {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2rem, 3.5vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .stat span {
    margin-top: 0.45rem;
    font-size: 0.84rem;
    font-weight: 680;
  }

  .stat small {
    margin-top: 0.2rem;
    color: var(--ink-soft);
    font-size: 0.69rem;
    line-height: 1.45;
  }

  .stat--rust {
    --accent: var(--rust);
  }

  .stat--blue {
    --accent: var(--blue);
  }

  .stat--gray {
    --accent: var(--gray);
  }

  .stat--gold {
    --accent: var(--gold);
  }

  .stat--teal {
    --accent: var(--teal);
  }

  figcaption {
    margin-top: 1rem;
    padding-top: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.69rem;
  }

  @media (max-width: 700px) {
    .stat-strip__grid {
      grid-template-columns: 1fr;
    }

    .stat {
      padding: 0.85rem 0;
      border-top: 1px solid var(--rule);
      border-left: 0;
    }

    .stat:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>
