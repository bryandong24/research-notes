---
interface Props {
  src: string;
  label: string;
  detail?: string;
}

const { src, label, detail } = Astro.props;
const href = `${import.meta.env.BASE_URL}${src.replace(/^\/+/, "")}`;
---

<p class="standalone-link">
  <a href={href}>
    <span aria-hidden="true">▶</span>
    {label}
  </a>
  {detail && <small>{detail}</small>}
</p>

<style>
  .standalone-link {
    width: min(720px, 100%);
    margin: -1.6rem auto 2.5rem;
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    color: var(--ink-soft);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.74rem;
    font-weight: 600;
  }

  small {
    font-size: 0.66rem;
  }

  @media (max-width: 620px) {
    .standalone-link {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
